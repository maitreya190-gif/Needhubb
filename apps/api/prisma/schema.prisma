generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum VerificationLevel {
  EMAIL
  PHONE
  ID
}

enum NeedType {
  EARN
  CONNECT
}

enum EarnCategory {
  TUTORING
  FREELANCE
  GOODS_BUY
  GOODS_SELL
  REPAIR
  OTHER
}

enum ConnectCategory {
  STUDY_PARTNER
  ACTIVITY_PARTNER
  HOBBY
  MENTOR
  OTHER
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  CLOSED
  // Deadline passed on an urgent need with no resolution. System-set only —
  // never user-settable (see lib/urgency.ts) — and excluded from discovery.
  EXPIRED
}

enum InterestResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum CertificateType {
  NSS
  TREE_PLANTATION
  CLEANUP
  VOLUNTEERING
  OTHER
}

enum AchievementCategory {
  COMPETITION
  HACKATHON
  TOURNAMENT
  AWARD
  OTHER
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BoostTargetType {
  PROFILE
  NEED
}

enum ReportTargetType {
  USER
  NEED
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  username          String?           @unique
  emailVerifiedAt   DateTime?
  phone             String?           @unique
  phoneVerifiedAt   DateTime?
  displayName       String
  passwordHash      String
  verificationLevel VerificationLevel @default(EMAIL)
  referralCode      String?           @unique
  referredBy        String?
  createdAt         DateTime          @default(now())

  profile                Profile?
  needs                  Need[]             @relation("PosterNeeds")
  responses              InterestResponse[]
  sentMessages           Message[]
  reviewsGiven           Review[]           @relation("ReviewsGiven")
  reviewsReceived        Review[]           @relation("ReviewsReceived")
  certificates           Certificate[]
  achievements           Achievement[]
  pointsLedger           PointsLedger[]
  visibilityBoosts       VisibilityBoost[]
  reports                Report[]           @relation("ReporterReports")
  emailVerification      EmailVerification?
  phoneVerification      PhoneVerification?
  notifications          Notification[]
  redemptions            Redemption[]
  dmMessagesSent         DmMessage[]        @relation("DmSender")
  friendRequestsSent     FriendRequest[]    @relation("FriendReqFrom")
  friendRequestsReceived FriendRequest[]    @relation("FriendReqTo")
  blocksMade             Block[]            @relation("Blocker")
  blocksReceived         Block[]            @relation("Blocked")
  referralsMade          Referral[]         @relation("ReferralsMade")
  urgencyProfile         UrgencyProfile?
}

// Internal-only track record of how this user has used Urgency Mode.
// Deliberately separate from Trust Score (see lib/trust-score.ts) — this is a
// distinct, private signal that only the urgency AI evaluation reads. Never
// serialized in any API response; there is no route that returns this model.
model UrgencyProfile {
  userId         String @id
  // 0..1, starts neutral. Nudged by lib/urgency.ts after each urgent need's
  // outcome (fulfilled before deadline vs. expired with no engagement).
  reliability    Float  @default(0.5)
  urgentCount    Int    @default(0)
  justifiedCount Int    @default(0)
  misusedCount   Int    @default(0)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  bio                    String?
  gender                 String?
  locationText           String?
  lat                    Float?
  lng                    Float?
  pointsTotal            Int       @default(0)
  avatarUrl              String?
  promptSkill            String?
  promptCollab           String?
  promptNeed             String?
  chitchatAvailableUntil DateTime?
  faceVerifiedAt         DateTime?
  personalityTraits      Json?
  personalityNickname    String?
  personalitySummary     String?
  personalityVibeTags    String[]  @default([])
  personalityTakenAt     DateTime?
  updatedAt              DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    ProfileSkill[]
  interests ProfileInterest[]
}

model Skill {
  id       String         @id @default(cuid())
  label    String         @unique
  profiles ProfileSkill[]
}

model Interest {
  id       String            @id @default(cuid())
  label    String            @unique
  profiles ProfileInterest[]
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@id([profileId, skillId])
}

model ProfileInterest {
  profileId  String
  interestId String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([profileId, interestId])
}

model Need {
  id              String           @id @default(cuid())
  posterId        String
  title           String
  description     String
  needType        NeedType
  earnCategory    EarnCategory?
  connectCategory ConnectCategory?
  isPaid          Boolean          @default(false)
  budgetMin       Float?
  budgetMax       Float?
  // Reused for Urgency Mode's deadline too — it was already optional and
  // already unused by ranking, so urgent needs need no separate column.
  deadline        DateTime?
  locationText    String?
  lat             Float?
  lng             Float?
  status          NeedStatus       @default(OPEN)
  parentNeedId    String?
  createdAt       DateTime         @default(now())

  // ── Urgency (optional, additive — see lib/urgency.ts) ──────────────────
  // Off by default; existing needs and existing flows are entirely unaffected.
  isUrgent          Boolean @default(false)
  // Internal AI confidence in [0,1] that this need's urgency is justified.
  // Set once, silently, right after creation when isUrgent is true. Read only
  // by the ranking pipeline — never selected into any client-facing response.
  urgencyConfidence Float?
  // 0 for an original need; N+1 for the need created by renewing a need at
  // generation N. Dampens the urgency boost each renewal can earn, so
  // repeatedly renewing the same need cannot keep the same visibility
  // forever — see renewalDampeningFactor in lib/urgency.ts.
  renewalGeneration Int     @default(0)

  poster     User               @relation("PosterNeeds", fields: [posterId], references: [id], onDelete: Cascade)
  parentNeed Need?              @relation("SubNeeds", fields: [parentNeedId], references: [id])
  subNeeds   Need[]             @relation("SubNeeds")
  responses  InterestResponse[]
  reviews    Review[]
  urgencyEvaluationLogs UrgencyEvaluationLog[]
}

// Internal-only record of each urgency AI evaluation — the "why" behind a
// urgencyConfidence value, kept for debugging and for improving future
// evaluations. Never joined into any needs-router select/include, and there
// is no route that returns it: unlike Need.urgencyConfidence, which needs
// stripInternalUrgencyFields() to stay hidden, this is invisible by
// construction — nothing reads it back into a response.
model UrgencyEvaluationLog {
  id                String   @id @default(cuid())
  needId            String
  confidence        Float
  // Short natural-language summary from the LLM of why it judged the
  // urgency the way it did (including the delay-cost read). Null when the
  // LLM was unavailable and the evaluation fell back to heuristics alone.
  reasoning         String?
  usedLlm           Boolean
  renewalGeneration Int
  createdAt         DateTime @default(now())

  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@index([needId])
}

model InterestResponse {
  id             String                 @id @default(cuid())
  needId         String
  responderId    String
  message        String
  quotedPrice    Float?
  workSampleUrl  String?
  status         InterestResponseStatus @default(PENDING)
  createdAt      DateTime               @default(now())

  need      Need           @relation(fields: [needId], references: [id], onDelete: Cascade)
  responder User           @relation(fields: [responderId], references: [id], onDelete: Cascade)
  thread    MessageThread?
  revisions ResponseRevision[]

  @@unique([needId, responderId])
}

model ResponseRevision {
  id             String   @id @default(cuid())
  responseId     String
  message        String
  quotedPrice    Float?
  workSampleUrl  String?
  createdAt      DateTime @default(now())

  response InterestResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
}

model MessageThread {
  id         String   @id @default(cuid())
  responseId String   @unique
  createdAt  DateTime @default(now())

  response InterestResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  needId     String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  need     Need @relation(fields: [needId], references: [id], onDelete: Cascade)
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
}

model Certificate {
  id            String          @id @default(cuid())
  userId        String
  type          CertificateType
  description   String?
  fileUrl       String
  status        ReviewStatus    @default(PENDING_REVIEW)
  pointsAwarded Int?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String              @id @default(cuid())
  userId      String
  title       String
  description String?
  category    AchievementCategory
  fileUrl     String?
  status      ReviewStatus        @default(PENDING_REVIEW)
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VisibilityBoost {
  id         String          @id @default(cuid())
  userId     String
  targetType BoostTargetType
  targetId   String
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())

  reporter User        @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  meta     ReportMeta?
}

// ── Full-scope additions ───────────────────────────────────────────────────

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  NEED_RESPONSE_RECEIVED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  POINTS_AWARDED
  CERT_APPROVED
  CERT_REJECTED
  REDEMPTION_READY
  REPORT_ACTIONED
  SKILL_MATCH_NEED
}

enum RedemptionStatus {
  PENDING
  DELIVERED
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  fromUser User @relation("FriendReqFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendReqTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model DmThread {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  messages DmMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DmMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  imageUrl  String?
  replyToId String?
  reactions Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread  DmThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender  User        @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo DmMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies DmMessage[] @relation("MessageReplies")

  @@index([threadId, createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReportMeta {
  reportId String @id
  source   String // 'user' | 'moderation_hard' | 'moderation_soft'
  detail   Json?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([source])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  refType   String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model RedemptionItem {
  id          String  @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  pointsCost  Int
  stock       Int     @default(-1)
  active      Boolean @default(true)

  redemptions Redemption[]
}

model Redemption {
  id        String           @id @default(cuid())
  userId    String
  itemId    String
  code      String
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item RedemptionItem @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
}

enum ReferralStatus {
  PENDING
  ACTIVATED
}

model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  refereeId   String         @unique
  status      ReferralStatus @default(PENDING)
  activatedAt DateTime?
  createdAt   DateTime       @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
}
