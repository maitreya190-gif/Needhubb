generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum VerificationLevel {
  EMAIL
  PHONE
  ID
}

enum NeedType {
  EARN
  CONNECT
}

enum EarnCategory {
  TUTORING
  FREELANCE
  GOODS_BUY
  GOODS_SELL
  REPAIR
  OTHER
}

enum ConnectCategory {
  STUDY_PARTNER
  ACTIVITY_PARTNER
  HOBBY
  MENTOR
  OTHER
}

enum NeedStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  CLOSED
}

enum InterestResponseStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum CertificateType {
  NSS
  TREE_PLANTATION
  CLEANUP
  VOLUNTEERING
  OTHER
}

enum AchievementCategory {
  COMPETITION
  HACKATHON
  TOURNAMENT
  AWARD
  OTHER
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum BoostTargetType {
  PROFILE
  NEED
}

enum ReportTargetType {
  USER
  NEED
  MESSAGE
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  username          String?           @unique
  emailVerifiedAt   DateTime?
  phone             String?           @unique
  phoneVerifiedAt   DateTime?
  displayName       String
  passwordHash      String
  verificationLevel VerificationLevel @default(EMAIL)
  createdAt         DateTime          @default(now())

  profile                Profile?
  needs                  Need[]             @relation("PosterNeeds")
  responses              InterestResponse[]
  sentMessages           Message[]
  reviewsGiven           Review[]           @relation("ReviewsGiven")
  reviewsReceived        Review[]           @relation("ReviewsReceived")
  certificates           Certificate[]
  achievements           Achievement[]
  pointsLedger           PointsLedger[]
  visibilityBoosts       VisibilityBoost[]
  reports                Report[]           @relation("ReporterReports")
  emailVerification      EmailVerification?
  notifications          Notification[]
  redemptions            Redemption[]
  dmMessagesSent         DmMessage[]        @relation("DmSender")
  friendRequestsSent     FriendRequest[]    @relation("FriendReqFrom")
  friendRequestsReceived FriendRequest[]    @relation("FriendReqTo")
  blocksMade             Block[]            @relation("Blocker")
  blocksReceived         Block[]            @relation("Blocked")
}

model Profile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  bio                    String?
  gender                 String?
  locationText           String?
  lat                    Float?
  lng                    Float?
  pointsTotal            Int       @default(0)
  avatarUrl              String?
  promptSkill            String?
  promptCollab           String?
  promptNeed             String?
  chitchatAvailableUntil DateTime?
  updatedAt              DateTime  @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    ProfileSkill[]
  interests ProfileInterest[]
}

model Skill {
  id       String         @id @default(cuid())
  label    String         @unique
  profiles ProfileSkill[]
}

model Interest {
  id       String            @id @default(cuid())
  label    String            @unique
  profiles ProfileInterest[]
}

model ProfileSkill {
  profileId String
  skillId   String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@id([profileId, skillId])
}

model ProfileInterest {
  profileId  String
  interestId String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([profileId, interestId])
}

model Need {
  id              String           @id @default(cuid())
  posterId        String
  title           String
  description     String
  needType        NeedType
  earnCategory    EarnCategory?
  connectCategory ConnectCategory?
  isPaid          Boolean          @default(false)
  budgetMin       Float?
  budgetMax       Float?
  deadline        DateTime?
  locationText    String?
  lat             Float?
  lng             Float?
  status          NeedStatus       @default(OPEN)
  parentNeedId    String?
  createdAt       DateTime         @default(now())

  poster     User               @relation("PosterNeeds", fields: [posterId], references: [id])
  parentNeed Need?              @relation("SubNeeds", fields: [parentNeedId], references: [id])
  subNeeds   Need[]             @relation("SubNeeds")
  responses  InterestResponse[]
  reviews    Review[]
}

model InterestResponse {
  id             String                 @id @default(cuid())
  needId         String
  responderId    String
  message        String
  quotedPrice    Float?
  workSampleUrl  String?
  status         InterestResponseStatus @default(PENDING)
  createdAt      DateTime               @default(now())

  need      Need           @relation(fields: [needId], references: [id])
  responder User           @relation(fields: [responderId], references: [id])
  thread    MessageThread?
}

model MessageThread {
  id         String   @id @default(cuid())
  responseId String   @unique
  createdAt  DateTime @default(now())

  response InterestResponse @relation(fields: [responseId], references: [id])
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id])
  sender User          @relation(fields: [senderId], references: [id])
}

model Review {
  id         String   @id @default(cuid())
  needId     String
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  need     Need @relation(fields: [needId], references: [id])
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}

model Certificate {
  id            String          @id @default(cuid())
  userId        String
  type          CertificateType
  description   String?
  fileUrl       String
  status        ReviewStatus    @default(PENDING_REVIEW)
  pointsAwarded Int?
  createdAt     DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Achievement {
  id          String              @id @default(cuid())
  userId      String
  title       String
  description String?
  category    AchievementCategory
  fileUrl     String?
  status      ReviewStatus        @default(PENDING_REVIEW)
  createdAt   DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model VisibilityBoost {
  id         String          @id @default(cuid())
  userId     String
  targetType BoostTargetType
  targetId   String
  expiresAt  DateTime

  user User @relation(fields: [userId], references: [id])
}

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())

  reporter User        @relation("ReporterReports", fields: [reporterId], references: [id])
  meta     ReportMeta?
}

// ── Full-scope additions ───────────────────────────────────────────────────

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum NotificationType {
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
  NEED_RESPONSE_RECEIVED
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  POINTS_AWARDED
  CERT_APPROVED
  CERT_REJECTED
  REDEMPTION_READY
  REPORT_ACTIONED
}

enum RedemptionStatus {
  PENDING
  DELIVERED
}

model FriendRequest {
  id         String              @id @default(cuid())
  fromUserId String
  toUserId   String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  fromUser User @relation("FriendReqFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendReqTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model DmThread {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  messages DmMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DmMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread DmThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User     @relation("DmSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReportMeta {
  reportId String @id
  source   String // 'user' | 'moderation_hard' | 'moderation_soft'
  detail   Json?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([source])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  refType   String?
  refId     String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model RedemptionItem {
  id          String  @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  pointsCost  Int
  stock       Int     @default(-1)
  active      Boolean @default(true)

  redemptions Redemption[]
}

model Redemption {
  id        String           @id @default(cuid())
  userId    String
  itemId    String
  code      String
  status    RedemptionStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item RedemptionItem @relation(fields: [itemId], references: [id])

  @@index([userId, createdAt])
}
