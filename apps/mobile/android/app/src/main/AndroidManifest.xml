<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Networking (API calls, Cloudinary, OSM map tiles) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Geolocator: current location -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- image_picker: gallery + camera access -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- speech_to_text: microphone for voice input -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:label="needhub"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shareable Need cards: a shared link's "Open in NeedHub" button
                 hands off to this scheme, which Flutter routes straight to
                 /need/<id> (see lib/router/router.dart). Custom scheme rather
                 than an https App Link on purpose — App Links additionally
                 require a verified assetlinks.json on the domain, and without
                 that verification Android silently stops opening the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="needhub"/>
            </intent-filter>
            <!-- App Link for the https share URL, so tapping a shared link in
                 WhatsApp opens the Need directly instead of via the browser.
                 autoVerify checks /.well-known/assetlinks.json on the host
                 (served by the API). If that check ever fails Android just
                 opens the link in a browser, which still shows the web
                 preview and its "Open in NeedHub" button — so the worst case
                 is exactly the behaviour without this filter. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                      android:host="needhubapi-production.up.railway.app"
                      android:pathPrefix="/n/"/>
            </intent-filter>
            <!-- Lets Flutter hand the incoming URI to go_router instead of
                 just cold-starting the app on its default screen. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
        </activity>
        <!-- image_cropper: UCrop activity. Theme must be Ucrop.CropTheme (not
             the older Theme.AppCompat.Light.NoActionBar) — image_cropper 8.1+
             requires it to opt the crop screen out of Android 15's forced
             edge-to-edge layout. Without it, the crop UI's toolbar and done/
             cancel buttons render underneath the system status/nav bars,
             making the crop screen look broken and hard to use. The style
             itself ships inside the image_cropper package, so no local
             styles.xml entry is needed. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.CropTheme"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ (package visibility) for canLaunchUrl to
             correctly detect an app that can open an https:// link — without
             this, the WhatsApp / Instagram share buttons in you_screen.dart
             silently fall back to "copy to clipboard" instead of actually
             opening the app, because canLaunchUrl always returns false. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
