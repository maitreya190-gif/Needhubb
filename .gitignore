# ── Node / API ─────────────────────────────────────────────────────────────
node_modules/
dist/
.turbo/
*.tsbuildinfo

# ── Environment (NEVER commit these) ───────────────────────────────────────
.env
.env.local
.env.*.local

# ── Flutter / Dart ──────────────────────────────────────────────────────────
**/android/.gradle/
**/android/local.properties
**/android/captures/
**/android/key.properties
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
**/*.g.dart
**/*.freezed.dart

