# Database (Neon Postgres over HTTP driver)
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require&channel_binding=require"

# Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Publishable key — used by the Flutter app, not the API. Kept here so the team has one source of truth.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM — server-side only, never expose to frontend
# Groq API key from console.groq.com (OpenAI-compatible)
LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Cohere embeddings for feed ranking (semantic interest matching)
# Free tier: 1000 requests/min. Sign up at cohere.com — no credit card needed.
# If missing, the ranker falls back to the substring heuristic (still works).
COHERE_API_KEY=your_cohere_api_key
COHERE_MODEL=embed-english-light-v3.0

# Cloudinary — shared image storage so all team members see the same uploads.
# Sign up free at cloudinary.com, then:
#   Settings → Upload → Upload presets → Add preset → Signing mode: Unsigned → name it needhub_uploads
# Your cloud name is shown at the top of the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=needhub_uploads

# Email — Gmail SMTP first (works for any recipient), Resend as fallback
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="NeedHub <your_email@gmail.com>"

# Lyzr AI — powers the "Suggest intro" feature in the apply sheet
# Get these from app.lyzr.ai → Settings → API Keys (key) and your created agent (agent ID)
LYZR_API_KEY=sk-default-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LYZR_AGENT_ID=your_agent_id
# Personality analyzer agent — powers the 10-question personality quiz
LYZR_PERSONALITY_AGENT_ID=your_personality_agent_id

# Face verification — Face++ (Megvii), free tier 1000 req/day
# Sign up at console.faceplusplus.com → create app → copy key + secret
FACEPP_API_KEY=your_facepp_api_key
FACEPP_API_SECRET=your_facepp_api_secret

# Phone verification (Trust Score) — Twilio Verify
# Sign up at twilio.com, then Console → Account SID + Auth Token, and create a
# Verify Service (Console → Verify → Services → Create, or
# POST https://verify.twilio.com/v2/Services) — copy its SID (starts "VA").
# Verify (not raw Messaging) is used because Twilio trial accounts reject
# arbitrary free-text SMS bodies — Verify generates/sends/checks the code itself.
# If any of these are missing, the OTP falls back to our own code logged to the
# server console — the dev bypass code 000000 still works either way, so phone
# verification is safe to leave unconfigured during development.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAyour_verify_service_sid

# App
PORT=3000
NODE_ENV=development
AUTH_SECRET=generate_a_random_64_char_hex_string
ADMIN_SECRET=generate_a_random_32_char_hex_string

# Base URL used to build public file URLs for local uploads.
# Android emulator reaches host machine via 10.0.2.2; set this to your LAN IP if
# testing on a physical device (e.g. http://192.168.1.x:3000).
API_BASE_URL=http://10.0.2.2:3000
