# Database (Neon Postgres over HTTP driver)
# Ask a team member for the shared Neon connection string.
# Format: postgresql://<user>:<pass>@<ep>-<pooler>.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth (Clerk)
# Get from clerk.com → your project → API keys
CLERK_SECRET_KEY=
# Publishable key — used by the Flutter app; kept here so the team has one source of truth
CLERK_PUBLISHABLE_KEY=

# LLM — server-side only, never expose to frontend
# Groq API key from console.groq.com (OpenAI-compatible, no card required)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Object storage (Cloudflare R2, S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=needhub
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# App
PORT=3000
NODE_ENV=development
# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
